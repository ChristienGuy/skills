#!/usr/bin/env bash
# bootstrap — translate skills.yaml into skillshare install commands.
#
# Usage:
#   ./bootstrap          install authored skills via skillshare (from this repo's remote),
#                        then install curated upstream skills.
#   ./bootstrap --dev    install authored skills from the local checkout (for live editing),
#                        then install curated upstream skills.
#
# Requires: bash 4+, skillshare, yq, git

set -euo pipefail

if (( "${BASH_VERSINFO[0]:-0}" < 4 )); then
  echo "bootstrap: needs bash 4+ (you have $BASH_VERSION). On macOS: brew install bash" >&2
  exit 1
fi

REPO_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
MANIFEST="$REPO_ROOT/skills.yaml"

DEV_MODE=0
[[ "${1:-}" == "--dev" ]] && DEV_MODE=1

for cmd in skillshare yq git; do
  command -v "$cmd" >/dev/null 2>&1 || { echo "bootstrap: missing required command: $cmd" >&2; exit 1; }
done
[[ -f "$MANIFEST" ]] || { echo "bootstrap: manifest not found at $MANIFEST" >&2; exit 1; }

# Skillshare runs git with prompts disabled, so credential helpers can't interactively
# answer the username prompt for private HTTPS clones. It does, however, honour
# GITHUB_TOKEN. If `gh` is installed and authed, plumb its token through automatically.
if [[ -z "${GITHUB_TOKEN:-}" ]] && command -v gh >/dev/null 2>&1; then
  if gh auth status >/dev/null 2>&1; then
    export GITHUB_TOKEN="$(gh auth token)"
  fi
fi
if [[ -z "${GITHUB_TOKEN:-}" ]]; then
  echo "bootstrap: warning — GITHUB_TOKEN not set and 'gh' is not authed." >&2
  echo "  Private repo installs will fail. Run 'gh auth login' or 'export GITHUB_TOKEN=...'." >&2
fi

# --- authored skills ---

mapfile -t AUTHORED < <(yq -r '.authored[]?' "$MANIFEST")

if [[ $DEV_MODE -eq 1 ]]; then
  echo "==> Dev mode: installing authored skills from $REPO_ROOT/skills/"
  for skill in "${AUTHORED[@]}"; do
    src="$REPO_ROOT/skills/$skill"
    if [[ ! -d "$src" ]]; then
      echo "  ! $skill: not found at $src" >&2
      continue
    fi
    skillshare install -g "$src" --update --yes
    echo "  + $skill"
  done
else
  echo "==> Installing authored skills via skillshare (from this repo's remote)"
  REPO_URL="$(git -C "$REPO_ROOT" config --get remote.origin.url 2>/dev/null || true)"
  if [[ -z "$REPO_URL" ]]; then
    echo "  ! no git remote configured. Either add one, or re-run with --dev." >&2
  elif [[ ${#AUTHORED[@]} -gt 0 ]]; then
    SELECTED="$(IFS=,; echo "${AUTHORED[*]}")"
    skillshare install -g "$REPO_URL" --skill "$SELECTED"
  else
    echo "  (no authored skills declared)"
  fi
fi

# --- curated upstream skills ---

echo "==> Installing curated upstream skills"
COUNT="$(yq -r '.upstreams | length // 0' "$MANIFEST")"
for ((i=0; i<COUNT; i++)); do
  REPO="$(yq -r ".upstreams[$i].repo // \"\"" "$MANIFEST")"
  REF="$(yq -r ".upstreams[$i].ref // \"main\"" "$MANIFEST")"
  mapfile -t SKILLS < <(yq -r ".upstreams[$i].skills[]?" "$MANIFEST")

  if [[ -z "$REPO" ]]; then
    echo "  ! entry $i: no repo, skipping" >&2
    continue
  fi
  if [[ ${#SKILLS[@]} -eq 0 ]]; then
    echo "  ! $REPO: no skills selected, skipping" >&2
    continue
  fi

  SELECTED="$(IFS=,; echo "${SKILLS[*]}")"
  echo "  + $REPO@$REF: $SELECTED"
  skillshare install -g "$REPO" --branch "$REF" --skill "$SELECTED"
done

echo "==> Done. Run 'skillshare sync' to push to your AI tools."
